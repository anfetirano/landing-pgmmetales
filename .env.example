# Google Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXX

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Optional: custom domain/proxy for Clerk (recommended in production)
# NEXT_PUBLIC_CLERK_DOMAIN=auth.tudominio.com
# NEXT_PUBLIC_CLERK_PROXY_URL=https://auth.tudominio.com

# Convex (se generan con `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-app.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-app.convex.site

# PMR private control page (optional overrides)
PMR_ACCESS_KEY=panama2026
PMR_SESSION_SECRET=change-this-secret
